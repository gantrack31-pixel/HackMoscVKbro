# Скопируйте в .env. Ключ хранится только на сервере, никогда не в React.
LLM_MODE=demo
# Для реальной генерации: LLM_MODE=live и данные вашего провайдера.
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3-32B
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=9000
# Некоторые совместимые провайдеры не поддерживают response_format.
LLM_JSON_MODE=true
LLM_TEMPERATURE=0.3
LLM_CONTEXT_AUDIT=true
# Необязательные параметры конкретного провайдера (JSON), без секретов.
LLM_EXTRA_BODY={}

DATABASE_PATH=data/deckly.sqlite3
# Облачный PostgreSQL (Supabase / Neon / свой сервер). Только на Python-сервере.
# Пример: postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=verify-full&sslrootcert=system
CLOUD_DATABASE_URL=
STORAGE_PATH=data
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Для публичного сервера укажите HTTPS-адрес и COOKIE_SECURE=true.
PUBLIC_BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false

# Создайте приложение Яндекс OAuth с правами login:info и login:email (docs/YANDEX_ID.md).
# Redirect URI должен точно совпадать с адресом в настройках приложения.
YANDEX_CLIENT_ID=
# Необязательно: при PKCE достаточно Client ID.
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://127.0.0.1:8000/api/auth/yandex/callback
