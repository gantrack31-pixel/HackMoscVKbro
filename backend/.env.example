# Скопируйте в .env. Ключ хранится только на сервере, никогда не в React.
APP_ENV=development
# Разрешайте только при осознанном развёртывании демонстрационной версии.
ALLOW_DEMO_IN_PRODUCTION=false
LLM_MODE=demo
# Для реальной генерации: LLM_MODE=live и данные вашего провайдера.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=http://127.0.0.1:8000
OPENROUTER_MODEL=qwen/qwen3.8-27b
# Custom OpenAI-compatible provider: explicitly set ALL three to opt in.
# LLM_BASE_URL=http://127.0.0.1:8001/v1
# LLM_MODEL=Qwen/Qwen3.8-27B
# LLM_API_KEY=
# Set true only for a model that accepts image_url inputs. Sends up to 4 template images.
LLM_VISION_ENABLED=false
# Network inactivity timeout, NOT a total AI execution limit. Full builds: 300s.
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=8000
LLM_OUTLINE_MAX_TOKENS=12000
LLM_DESIGN_MAX_TOKENS=16000
LLM_ASSISTANT_MAX_TOKENS=8000
LLM_AUDIT_MAX_TOKENS=4000
# Некоторые совместимые провайдеры не поддерживают response_format.
LLM_JSON_MODE=true
LLM_TEMPERATURE=0.3
LLM_CONTEXT_AUDIT=true
# Необязательные параметры конкретного провайдера (JSON), без секретов.
LLM_EXTRA_BODY={}

# Опциональная генерация изображений FLUX.1-schnell (12B); docs/REQUIREMENTS.md.
# Локальный worker: http://127.0.0.1:8002. Внешний сервис требует HTTPS.
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_CONCURRENCY=2

DATABASE_PATH=data/deckly.sqlite3
# Облачный PostgreSQL (Supabase / Neon / свой сервер). Только на Python-сервере.
# Пример: postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=verify-full&sslrootcert=system
CLOUD_DATABASE_URL=
STORAGE_PATH=data
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Для production: APP_ENV=production, публичный HTTPS URL и COOKIE_SECURE=true.
# CORS_ORIGINS перечисляет доверенные HTTPS origins через запятую; включите PUBLIC_BASE_URL.
PUBLIC_BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false

# Email confirmation. SMTP password must remain only in this backend .env file.
EMAIL_VERIFICATION_REQUIRED=true
# Without SMTP, development does not send or log confirmation links.
# Production requires every SMTP value below.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
# TLS-only SMTP: auto selects STARTTLS on 587, SSL otherwise.
SMTP_SECURITY=auto
# Support recipient; blank uses EMAIL_FROM. User email is only Reply-To.
SUPPORT_TO=
# Accepted/pending messages per account per 15 min (default: 30 dev / 5 prod).
# SUPPORT_RATE_LIMIT=5

# Создайте приложение Яндекс OAuth с правами login:info и login:email (docs/YANDEX_ID.md).
# Redirect URI должен точно совпадать с адресом в настройках приложения.
YANDEX_CLIENT_ID=
# Необязательно: при PKCE достаточно Client ID.
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://127.0.0.1:8000/api/auth/yandex/callback
# Enable cloud_api:disk.app_folder in your OAuth app, then connect Disk in the UI.
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this stable, private and backed up separately from SQLite.
YANDEX_DISK_TOKEN_KEY=
