# Copy this file to .env.docker; keep all credentials in the ignored local file.
APP_ENV=development
LLM_MODE=demo
PUBLIC_BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional live LLM provider.
# LLM_MODE=live
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct
# OPENROUTER_HTTP_REFERER=https://YOUR_PUBLIC_SITE

# Optional Yandex OAuth. Redirect URI must match the Yandex OAuth application.
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# YANDEX_REDIRECT_URI=http://127.0.0.1:8000/api/auth/yandex/callback

# Optional SMTP for email verification and support mail.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=
