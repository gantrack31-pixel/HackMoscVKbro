# Copy this file to .env.docker; keep all credentials in the ignored local file.
APP_ENV=development
LLM_MODE=demo
PUBLIC_BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional live LLM provider.
# LLM_MODE=live
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen3.8-27b
# Custom provider (explicit opt-in; never mixes keys with OPENROUTER_*):
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_MODEL=Qwen/Qwen3.8-27B
# LLM_API_KEY=
# OPENROUTER_HTTP_REFERER=https://YOUR_PUBLIC_SITE
# Network inactivity, not a business execution limit (full builds: 300s).
# LLM_TIMEOUT_SECONDS=180
# LLM_OUTLINE_MAX_TOKENS=12000
# LLM_DESIGN_MAX_TOKENS=16000
# LLM_ASSISTANT_MAX_TOKENS=8000
# LLM_AUDIT_MAX_TOKENS=4000
# IMAGE_CONCURRENCY=2

# Optional Yandex OAuth. Redirect URI must match the Yandex OAuth application.
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# YANDEX_REDIRECT_URI=http://127.0.0.1:8000/api/auth/yandex/callback
# YANDEX_DISK_TOKEN_KEY=
# OAuth scope for Disk: cloud_api:disk.app_folder (see docs/INTEGRATIONS.md).

# Optional SMTP for email verification and support mail.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURITY=auto
# SUPPORT_TO=
# SUPPORT_RATE_LIMIT=5
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=
