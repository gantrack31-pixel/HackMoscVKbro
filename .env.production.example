# Copy to .env.production on the server and fill in. Never commit the real file.
# Replace deckly.example.ru with your domain everywhere below.
APP_ENV=production
PUBLIC_BASE_URL=https://deckly.example.ru
CORS_ORIGINS=https://deckly.example.ru
COOKIE_SECURE=true

LLM_MODE=live
LLM_BASE_URL=https://ai-demo.platformpreview.ru/api/inference-providers-router/00000000-0000-0000-0000-000000000001/v1
LLM_API_KEY=
LLM_PROJECT_ID=
LLM_MODEL=qwen38-27b-fp8
LLM_JSON_MODE=false
# Used only for AssistantPlan requests to OpenRouter with JSON mode enabled.
LLM_ASSISTANT_JSON_SCHEMA=true

# Production requires SMTP while email verification is on.
# For a quick demo without mail set EMAIL_VERIFICATION_REQUIRED=false.
EMAIL_VERIFICATION_REQUIRED=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=auto
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
SUPPORT_TO=

# Optional Yandex ID. Register this exact callback in the Yandex OAuth app.
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# YANDEX_REDIRECT_URI=https://deckly.example.ru/api/auth/yandex/callback
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# YANDEX_DISK_TOKEN_KEY=

# Optional image generation / cloud storage.
# IMAGE_BASE_URL=
# IMAGE_API_KEY=
# CLOUD_DATABASE_URL=
